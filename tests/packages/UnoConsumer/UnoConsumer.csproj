<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VisualizeSceneVersion Condition="'$(VisualizeSceneVersion)' == ''">0.1.0</VisualizeSceneVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="VisualizeScene.Controls.Uno" Version="$(VisualizeSceneVersion)" />
  </ItemGroup>
</Project>
