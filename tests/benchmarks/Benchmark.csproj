<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <SourceRoot Condition="'$(SourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)/src/VisualizeScene.Editing/VisualizeScene.Editing.csproj" />
    <ProjectReference Include="$(SourceRoot)/src/VisualizeScene.Layout/VisualizeScene.Layout.csproj" />
    <ProjectReference Include="$(SourceRoot)/src/VisualizeScene.Rendering.Skia/VisualizeScene.Rendering.Skia.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
  </ItemGroup>
</Project>
